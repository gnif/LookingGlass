#!/usr/bin/env bash
# Libvirt QEMU hook for dynamic dGPU passthrough
# Install to: /etc/libvirt/hooks/qemu (chmod +x)

guest="$1"
action="$2"
subaction="$3"

[ "$guest" = "win11" ] || exit 0

gpu="0000:01:00.0"
audio="0000:01:00.1"

gpu_ids="10de 28e0"
audio_ids="10de 22be"

case "$action/$subaction" in
    prepare/begin)
        modprobe vfio-pci

        for dev in "$gpu" "$audio"; do
            if [ -e "/sys/bus/pci/devices/$dev/driver/unbind" ]; then
                echo "$dev" > "/sys/bus/pci/devices/$dev/driver/unbind"
            fi
        done

        for ids in "$gpu_ids" "$audio_ids"; do
            echo "$ids" > /sys/bus/pci/drivers/vfio-pci/new_id 2>/dev/null
        done

        for dev in "$gpu" "$audio"; do
            echo "$dev" > /sys/bus/pci/drivers/vfio-pci/bind 2>/dev/null
        done
        ;;

    release/end)
        for dev in "$gpu" "$audio"; do
            echo "$dev" > /sys/bus/pci/drivers/vfio-pci/unbind 2>/dev/null
        done

        modprobe nvidia
        modprobe nvidia_drm
        modprobe snd_hda_intel

        echo "$gpu" > /sys/bus/pci/drivers/nvidia/bind 2>/dev/null
        echo "$audio" > /sys/bus/pci/drivers/snd_hda_intel/bind 2>/dev/null
        ;;
esac
