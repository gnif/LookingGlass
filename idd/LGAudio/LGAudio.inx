[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4D36E96C-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
DriverVer=08/21/2026,0.1.0.0
CatalogFile=LGAudio.cat
PnpLockDown=1

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
LGAudio.sys=1

[Manufacturer]
%ManufacturerName%=LGAudio,NT$ARCH$.10.0...16299

[LGAudio.NT$ARCH$.10.0...16299]
%DeviceName%=LGAudio_Device,Root\LGAudio

[DestinationDirs]
LGAudio_CopyFiles=13

[LGAudio_CopyFiles]
LGAudio.sys

[LGAudio_Device.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=LGAudio_CopyFiles
AddReg=LGAudio_Device.AddReg

[LGAudio_Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,LGAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[LGAudio_Device.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveRender%,LGAudio.WaveRender
AddInterface=%KSCATEGORY_RENDER%,%KSNAME_WaveRender%,LGAudio.WaveRender
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveRender%,LGAudio.WaveRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyRender%,LGAudio.TopologyRender
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyRender%,LGAudio.TopologyRender
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_WaveCapture%,LGAudio.WaveCapture
AddInterface=%KSCATEGORY_CAPTURE%,%KSNAME_WaveCapture%,LGAudio.WaveCapture
AddInterface=%KSCATEGORY_REALTIME%,%KSNAME_WaveCapture%,LGAudio.WaveCapture
AddInterface=%KSCATEGORY_AUDIO%,%KSNAME_TopologyCapture%,LGAudio.TopologyCapture
AddInterface=%KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyCapture%,LGAudio.TopologyCapture

[LGAudio.WaveRender]
AddReg=LGAudio.WaveRender.AddReg

[LGAudio.WaveRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%

[LGAudio.TopologyRender]
AddReg=LGAudio.TopologyRender.AddReg

[LGAudio.TopologyRender.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[LGAudio.WaveCapture]
AddReg=LGAudio.WaveCapture.AddReg

[LGAudio.WaveCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%

[LGAudio.TopologyCapture]
AddReg=LGAudio.TopologyCapture.AddReg

[LGAudio.TopologyCapture.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%EndpointName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[LGAudio_Device.NT.Services]
AddService=LGAudio,0x00000002,LGAudio_Service

[LGAudio_Service]
DisplayName=%ServiceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\LGAudio.sys

[LGAudio_Device.NT.HW]
AddReg=LGAudio_HardwareSettings

[LGAudio_HardwareSettings]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[Strings]
ProviderName="Looking Glass"
ManufacturerName="Looking Glass"
DiskName="Looking Glass Audio Installation Disk"
DeviceName="Looking Glass Audio"
EndpointName="Looking Glass Audio"
ServiceName="Looking Glass Audio Driver"

KSNAME_WaveRender="WaveRender"
KSNAME_TopologyRender="TopologyRender"
KSNAME_WaveCapture="WaveCapture"
KSNAME_TopologyCapture="TopologyCapture"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
